<UserControl x:Class="GameBooster.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Compte" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="Nom d'utilisateur" Style="{StaticResource Muted}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                    <TextBlock Text="Mot de passe" Style="{StaticResource Muted}"/>
                    <PasswordBox x:Name="PasswordInput" Margin="0,4,0,8"/>
                    <CheckBox Content="Se souvenir de moi sur ce PC" IsChecked="{Binding RememberSession}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Connexion" Style="{StaticResource PrimaryButton}" Click="Login_Click" Margin="0,0,8,0"/>
                        <Button Content="Créer le compte" Click="Register_Click"/>
                    </StackPanel>
                    <Button Content="Continuer sans compte" Command="{Binding ContinueCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Identity}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SyncLine}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CacheLine}" Style="{StaticResource Muted}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Presets personnels, préférences et historique sont dans Cloudflare D1. Seule la sauvegarde des tweaks de ce PC reste locale."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Synchroniser" Style="{StaticResource PrimaryButton}" Command="{Binding SyncCommand}" Margin="0,0,8,0"/>
                        <Button Content="Déconnexion" Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
