<UserControl x:Class="GameBooster.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Démarrage" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="Active ou désactive les entrées via StartupApproved. Le raccourci ou la commande reste en place."/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Actualiser" Command="{Binding RefreshCommand}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding ToggleLabel}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Location, Mode=OneWay}" Foreground="{StaticResource Brush.Faint}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Command}" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
