<UserControl x:Class="GameBooster.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBooster.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16" Text="Charge du PC en direct. Le boost rapide applique le preset actif."/>
            <WrapPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <controls:GaugeControl Value="{Binding Cpu}" ValueLabel="{Binding CpuLabel}" Caption="Processeur" Accent="{Binding CpuBrush}"/>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <controls:GaugeControl Value="{Binding Ram}" ValueLabel="{Binding RamLabel}" Caption="Mémoire" Accent="{Binding RamBrush}"/>
                        <TextBlock Text="{Binding RamDetail}" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Faint}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <controls:GaugeControl Value="{Binding Gpu}" ValueLabel="{Binding GpuLabel}" Caption="GPU 3D" Accent="{Binding GpuBrush}"/>
                        <TextBlock Text="{Binding TempLabel}" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Faint}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Processeur, dernière minute" Style="{StaticResource Muted}"/>
                    <controls:SparklineControl Margin="0,8,0,0" Samples="{Binding Samples}"/>
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Boost rapide" Style="{StaticResource PrimaryButton}" Command="{Binding QuickBoostCommand}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Preset actif" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding ActivePresetName}" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Historique récent" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" Foreground="{StaticResource Brush.Muted}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
