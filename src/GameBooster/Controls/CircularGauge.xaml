<UserControl x:Class="GameBooster.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid>
        <Ellipse x:Name="Track" Fill="Transparent" Stroke="{StaticResource Brush.Line}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="GlowArc" Fill="Transparent" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" StrokeLineJoin="Round"/>
        <Ellipse x:Name="ValueArc" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <StackPanel x:Name="Center" VerticalAlignment="Center" Margin="28,0">
            <TextBlock x:Name="ReadingText" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text}" TextAlignment="Center"/>
            <TextBlock x:Name="CaptionText" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock x:Name="DetailText" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Faint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
