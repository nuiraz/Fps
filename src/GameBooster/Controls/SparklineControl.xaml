             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="72">
    <Grid>
        <Polyline x:Name="Line" Stroke="{StaticResource Brush.Lime}" StrokeThickness="2" StrokeLineJoin="Round"/>
    </Grid>
</UserControl>
