<UserControl x:Class="GameBooster.Controls.GaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="148" Height="148">
    <Grid>
        <Path x:Name="Track" Stroke="{StaticResource Brush.Line}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path x:Name="ValueArc" Stroke="{StaticResource Brush.Lime}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <StackPanel VerticalAlignment="Center" Margin="16,0,16,8">
            <TextBlock x:Name="ValueText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text}"/>
            <TextBlock x:Name="CaptionText" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
